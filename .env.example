# CASCADE configuration. Copy to .env for local runs. NEVER put real secrets in this file.
# deploy/run_all.sh generates real secrets into secrets/ (git-ignored).

# --- runtime switches -------------------------------------------------------
CASCADE_MODE=services          # services (Redis bus) | single (one process, asyncio bus)
CASCADE_DB=postgres            # postgres | sqlite
CASCADE_ML=auto                # auto | xgboost | hgb  (hgb = scikit-learn fallback)
GENAI_BACKEND=template         # lab | transformers | llamacpp | template
DEMO_MODE=0                    # 1 enables the "Run demo script" admin endpoint
LOOP1_NO_KNOWN_PRIOR=0         # 1 = score with the model trained without pair_in_known_list
LOOP1_THRESHOLD=               # optional override of the threshold saved in blend.json

# --- connections ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://cascade@localhost:5432/cascade
POSTGRES_PASSWORD=             # generated by run_all.sh into secrets/
SQLITE_PATH=data/generated/cascade.sqlite3
SCORER_URL=http://localhost:8001
GENAI_URL=http://localhost:8003

# --- paths ------------------------------------------------------------------
CASCADE_DATA_DIR=data
CASCADE_GENERATED_DIR=data/generated
CASCADE_MODEL_DIR=loop1/model
CASCADE_STATE_DIR=data/generated/state
CASCADE_EPOCH=2023-01-01

# --- secrets (generated; leave empty here) ----------------------------------
EDGE_SECRET=                   # edge only: HMAC-SHA256 tokenisation key (hex)
DATA_KEY=                      # base64 of 32 random bytes, AES-256-GCM at rest
REGULATOR_KEY=
PHARMACIST_KEY_PH001=          # one PHARMACIST_KEY_<pharmacy_id> per pharmacy
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Loop 2 -----------------------------------------------------------------
LOOP2_RECOMPUTE_EVENTS=5000
LOOP2_RECOMPUTE_SECONDS=10

# --- GenAI ------------------------------------------------------------------
GENAI_TIMEOUT_S=10
GENAI_MAX_TOKENS=220
GENAI_TEMPERATURE=0.1          # capped at 0.2
GENAI_MODEL=ibm-granite/granite-3.3-2b-instruct   # transformers backend
GENAI_LAB_URL=                 # lab backend: OpenAI-compatible /v1/chat/completions base URL
GENAI_LAB_MODEL=
GENAI_LAB_API_KEY=
LLAMACPP_MODEL_PATH=           # llamacpp backend: path to a GGUF file
